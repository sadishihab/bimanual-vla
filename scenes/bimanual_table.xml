<mujoco model="bimanual_table">
  <!-- Two SO-101 arms mounted on a table for a bimanual table-setting task.
       The single-arm model is pulled in twice via <attach>, which rewrites every
       name in the submodel (bodies, joints, geoms, sites, actuators, defaults)
       with the given prefix, so the left_ and right_ arms cannot collide. -->

  <compiler angle="radian" autolimits="true"/>
  <option timestep="0.002" integrator="implicitfast"/>

  <visual>
    <global offwidth="1920" offheight="1440" azimuth="140" elevation="-25"/>
    <quality shadowsize="4096" offsamples="8"/>
    <map znear="0.02" zfar="30"/>
  </visual>

  <asset>
    <model name="so101" file="../third_party/SO-ARM100/Simulation/SO101/so101_new_calib.xml"/>

    <texture name="skybox" type="skybox" builtin="gradient" rgb1="0.35 0.45 0.6" rgb2="0.1 0.12 0.16"
             width="512" height="512"/>
    <texture name="floor_tex" type="2d" builtin="checker" rgb1="0.24 0.26 0.29" rgb2="0.30 0.32 0.35"
             width="512" height="512"/>
    <material name="floor_mat" texture="floor_tex" texrepeat="6 6" reflectance="0.05"/>

    <material name="table_top_mat" rgba="0.75 0.60 0.42 1"/>
    <material name="table_leg_mat" rgba="0.30 0.24 0.18 1"/>
    <material name="plate_mat" rgba="0.95 0.95 0.93 1"/>
    <material name="mug_mat" rgba="0.20 0.42 0.75 1"/>
    <material name="spoon_mat" rgba="0.78 0.79 0.82 1"/>
    <material name="fork_mat" rgba="0.78 0.79 0.82 1"/>
    <material name="well_mat" rgba="0.55 0.55 0.53 1"/>
  </asset>

  <default>
    <!-- Manipulable props: light, high-friction contacts so they settle and stay put. -->
    <default class="prop">
      <geom condim="4" friction="1.0 0.02 0.001" solref="0.004 1" density="600"/>
    </default>
    <default class="table">
      <geom type="box" condim="3" friction="0.9 0.01 0.001"/>
    </default>
  </default>

  <worldbody>
    <light name="key" pos="0.3 0.6 2.2" dir="-0.1 -0.3 -1" directional="true" diffuse="0.55 0.55 0.55"/>
    <light name="fill" pos="0.3 -0.8 1.8" dir="-0.1 0.4 -1" diffuse="0.35 0.35 0.35" specular="0.1 0.1 0.1"/>

    <geom name="floor" type="plane" size="4 4 0.05" material="floor_mat" pos="0 0 0"/>

    <!-- ================= Table =================
         Top surface at z = 0.75, spanning x in [-0.36, 0.40], y in [-0.36, 0.36].
         Sized to the arms rather than to a real table: the bases sit at y = +/-0.2 with
         0.16 m of margin behind them, and every point of the top is within reach of at
         least one arm. See the reach note on the arm bodies below. -->
    <body name="table" pos="0.02 0 0">
      <geom name="table_top" class="table" pos="0 0 0.735" size="0.38 0.36 0.015" material="table_top_mat"/>
      <geom name="table_leg_fl" class="table" pos=" 0.34  0.32 0.36" size="0.025 0.025 0.36" material="table_leg_mat"/>
      <geom name="table_leg_fr" class="table" pos=" 0.34 -0.32 0.36" size="0.025 0.025 0.36" material="table_leg_mat"/>
      <geom name="table_leg_bl" class="table" pos="-0.34  0.32 0.36" size="0.025 0.025 0.36" material="table_leg_mat"/>
      <geom name="table_leg_br" class="table" pos="-0.34 -0.32 0.36" size="0.025 0.025 0.36" material="table_leg_mat"/>
    </body>

    <!-- ================= Arms =================
         Bases 0.4 m apart on Y, both facing +x across the table. Sampling the arm
         kinematics at table height (0.755 <= z <= 0.82) gives a shared reachable band of
         roughly x in [-0.15, 0.25], |y| <= 0.20 -- the centre strip of the table, where
         the place setting gets assembled. -->
    <body name="left_mount" pos="-0.15 0.2 0.75">
      <attach model="so101" body="base" prefix="left_"/>
    </body>
    <body name="right_mount" pos="-0.15 -0.2 0.75">
      <attach model="so101" body="base" prefix="right_"/>
    </body>

    <!-- ================= Props =================
         Sized to what this arm can actually grasp, from the measured envelope:
         the jaws open to 46 mm, and a top-down grasp needs its grip feature
         12-88 mm above the table -- below that the fingers hit the surface before
         they are beside the object, above that the arm runs out of top-down reach
         (the ceiling is 93 mm).  The old props satisfied none of this: a 150 mm
         plate and a 76 mm mug both exceeded the jaws, and the flatware lay flush
         on the table where the moving jaw's arc cannot reach its side.

         Each body carries exactly one geom named <prop>_grasp.  That is the
         feature pick() aims at, which is how a raised cutlery handle gets grasped
         instead of the flat head that dominates the bounding box.

         Body origins sit on the table surface, so every geom z below reads
         directly as height above the table top. -->

    <!-- Small round dish.  A full-size plate cannot be grasped by a 46 mm gripper
         at all, so the plate becomes a 34 mm footed dish with a raised rim, held
         across the body wall. -->
    <body name="plate" pos="0.08 0.00 0.7520" childclass="prop">
      <freejoint name="plate_free"/>
      <geom name="plate_foot" type="cylinder" pos="0 0 0.002" size="0.011 0.002" material="plate_mat"/>
      <geom name="plate_grasp" type="cylinder" pos="0 0 0.014" size="0.017 0.010" material="plate_mat"/>
      <geom name="plate_rim" type="cylinder" pos="0 0 0.0255" size="0.017 0.0015" material="plate_mat"/>
      <geom name="plate_well" type="cylinder" pos="0 0 0.0235" size="0.0135 0.001"
            material="well_mat" contype="0" conaffinity="0"/>
    </body>

    <!-- Mug: body narrowed to 36 mm so the body itself is grippable, with the
         handle kept.  The handle sits on the body's local +y because a round grasp
         geom ties its two horizontal half-extents, and the tie resolves to the
         local x axis -- so the jaws always close across x, never onto the handle. -->
    <body name="mug" pos="0.22 -0.26 0.7520" childclass="prop">
      <freejoint name="mug_free"/>
      <geom name="mug_grasp" type="cylinder" pos="0 0 0.032" size="0.018 0.032" material="mug_mat"/>
      <geom name="mug_handle_top" type="capsule" fromto="0 0.016 0.044 0 0.028 0.044" size="0.0035" material="mug_mat"/>
      <geom name="mug_handle_out" type="capsule" fromto="0 0.028 0.044 0 0.028 0.022" size="0.0035" material="mug_mat"/>
      <geom name="mug_handle_bot" type="capsule" fromto="0 0.028 0.022 0 0.016 0.022" size="0.0035" material="mug_mat"/>
    </body>

    <!-- Spoon and fork on a riser: the handle is lifted to 19-29 mm on a small
         pedestal at its far end, so the jaws can straddle a 12 mm bar with the
         fingers clear of the table.  The bowl and tines still rest on the top,
         which keeps the silhouette reading as cutlery. -->
    <body name="spoon" pos="0.08 -0.28 0.7520" childclass="prop">
      <freejoint name="spoon_free"/>
      <geom name="spoon_riser" type="box" pos="-0.058 0 0.0095" size="0.008 0.006 0.0095" material="spoon_mat"/>
      <geom name="spoon_grasp" type="box" pos="-0.028 0 0.024" size="0.034 0.006 0.005" material="spoon_mat"/>
      <geom name="spoon_neck" type="capsule" fromto="0.004 0 0.020 0.022 0 0.006" size="0.004" material="spoon_mat"/>
      <geom name="spoon_bowl" type="ellipsoid" pos="0.044 0 0.005" size="0.026 0.017 0.005" material="spoon_mat"/>
    </body>

    <body name="fork" pos="0.08 0.28 0.7520" childclass="prop">
      <freejoint name="fork_free"/>
      <geom name="fork_riser" type="box" pos="-0.058 0 0.0095" size="0.008 0.006 0.0095" material="fork_mat"/>
      <geom name="fork_grasp" type="box" pos="-0.028 0 0.024" size="0.034 0.006 0.005" material="fork_mat"/>
      <geom name="fork_neck" type="capsule" fromto="0.004 0 0.020 0.022 0 0.006" size="0.004" material="fork_mat"/>
      <geom name="fork_base" type="box" pos="0.032 0 0.004" size="0.010 0.013 0.004" material="fork_mat"/>
      <geom name="fork_tine1" type="box" pos="0.054 -0.0093 0.004" size="0.014 0.0028 0.003" material="fork_mat"/>
      <geom name="fork_tine2" type="box" pos="0.054 -0.0031 0.004" size="0.014 0.0028 0.003" material="fork_mat"/>
      <geom name="fork_tine3" type="box" pos="0.054  0.0031 0.004" size="0.014 0.0028 0.003" material="fork_mat"/>
      <geom name="fork_tine4" type="box" pos="0.054  0.0093 0.004" size="0.014 0.0028 0.003" material="fork_mat"/>
    </body>

    <!-- ================= Cameras =================
         Both frame the whole table, both arms and all four props. -->
    <camera name="overhead" pos="0.02 0 1.92" xyaxes="0 1 0 -1 0 0" fovy="45"/>
    <camera name="front" pos="1.25 0 1.20" xyaxes="0 1 0 -0.2736 0 0.9617" fovy="45"/>
  </worldbody>

  <!-- Ready pose: both arms raised over the table, grippers ~12 cm above the top.
       qpos is [12 arm joints | plate | mug | spoon | fork free joints]. -->
  <keyframe>
    <key name="home"
         qpos="0 -0.6 1.3 -0.6 0 0.6  0 -0.6 1.3 -0.6 0 0.6  0.08 0 0.752 1 0 0 0  0.22 -0.26 0.752 1 0 0 0  0.08 -0.28 0.752 1 0 0 0  0.08 0.28 0.752 1 0 0 0"
         ctrl="0 -0.6 1.3 -0.6 0 0.6  0 -0.6 1.3 -0.6 0 0.6"/>
  </keyframe>
</mujoco>
